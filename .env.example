# ── Qubits environment variables ──────────────────────────────────
# Copy to .env and adjust. All values are server-side only.

# OpenAI API key (required; server-side only, never reaches client code)
OPENAI_API_KEY=

# OpenAI model name
OPENAI_MODEL=gpt-4o-mini

# Optional global completion-token override. Role defaults are 16384 for Alex
# and 4096 for Mike/Emma.
# QUIBITS_PROVIDER_MAX_TOKENS=16384

# Optional global per-request timeout override. Defaults are 300s for Alex,
# 180s for Mike, and 120s for Emma.
# QUIBITS_PROVIDER_TIMEOUT_MS=300000

# Optional independent model used to turn private reasoning into short safe phase updates.
# Falls back to OPENAI_MODEL; the request has its own short deadline and never has tools.
# QUIBITS_SUMMARY_MODEL=gpt-4o-mini
# QUIBITS_PROGRESS_SUMMARY_TIMEOUT_MS=12000

# Optional: OpenAI-compatible base URL (default https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local database file path (server-side; can be a PostgreSQL URL in production)
DATABASE_URL="file:./data/qubits.db"

# Reference search provider: none | generic/brave/tavily
REFERENCE_SEARCH_PROVIDER=none
REFERENCE_SEARCH_API_KEY=
REFERENCE_SEARCH_BASE_URL=

# ── Sandbox provider ─────────────────────────────────────────────
# container  = ContainerSandbox（唯一且默认）：物理隔离——非 root、cap-drop=ALL、
#              no-new-privileges、只挂载 workspace（canonicalize 后）、只读根、禁网。
#              Docker 不可用时 fail closed，绝不回退到宿主执行。
# 只允许 container；设为任何其他值（local-dev/local-demo/none）将拒绝启动。
SANDBOX_PROVIDER=container
SANDBOX_COMMAND_ALLOWLIST=npm,node,npx,next,eslint,tsc,git,bash,sh
# ContainerSandbox 使用的镜像（默认 qubits-toolchain:latest：node:22 + 固定版本
# typescript/eslint/vitest 工具链，含 linux 原生二进制；用 scripts/build-toolchain-image.sh 构建）
# SANDBOX_IMAGE=qubits-toolchain:latest

# Compatibility mode: set true when the gateway rejects standard tool-call history.
# Downgrades assistant.tool_calls and role:"tool" to plain text with call ids,
# avoiding illegal orphan tool_calls.
OPENAI_TOOL_MESSAGE_COMPAT=false

# Max consecutive tool failures before stopping the agent with an error (default 3)
QUIBITS_MAX_TOOL_FAILURES=3
# Lifetime cap of counted tool failures across the whole agent run (default 24).
# Cheap recoverable failures such as PATCH_NO_MATCH still count toward the consecutive
# limit, but do not consume this lifetime budget.
QUIBITS_MAX_TOOL_FAILURES_TOTAL=24

# ── One-click deploy (一键上线) ────────────────────────────────────
# Deploys the conversation's built bundle into a hardened Docker container
# (cap-drop ALL / no-new-privileges / read-only / non-root / resource-limited,
# port published on 127.0.0.1 only) and exposes it behind the deploy router and a
# Cloudflare quick tunnel (free, no account, random trycloudflare.com hostname).
DEPLOY_ENABLED=1
DEPLOY_PUBLIC_TUNNEL=1
# Public link lifetime in hours (default 12; expired deployments stop automatically)
# DEPLOY_TTL_HOURS=12
# Deploy router port on 127.0.0.1 (default 3100)
# DEPLOY_ROUTER_PORT=3100
# Max concurrent live deployments (default 20)
# DEPLOY_MAX_DEPLOYMENTS=20
# Qubits origin port the router forwards /api/deploy/data to (default PORT or 3000)
# DEPLOY_ORIGIN_PORT=3000
# cloudflared binary override (auto-downloaded into ./bin when missing)
# DEPLOY_TUNNEL_BINARY=/usr/local/bin/cloudflared
