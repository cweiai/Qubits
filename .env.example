# ── Qubits environment variables ──────────────────────────────────
# Copy to .env and adjust. All values are server-side only.

# OpenAI API key (required; server-side only, never reaches client code)
OPENAI_API_KEY=

# OpenAI model name
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI-compatible base URL (default https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local database file path (server-side; can be a PostgreSQL URL in production)
DATABASE_URL="file:./data/qubits.db"

# Reference search provider: none | mock (tests only) | generic/brave/tavily
REFERENCE_SEARCH_PROVIDER=none
REFERENCE_SEARCH_API_KEY=
REFERENCE_SEARCH_BASE_URL=

# ── Sandbox provider ─────────────────────────────────────────────
# local-dev  = LocalDevSandbox：仅用于本地开发与测试，明确不是生产安全边界（无容器隔离）。
# container  = ContainerSandbox：生产接口。Docker 不可用时 fail closed，绝不回退到宿主执行。
# none       = 禁用沙盒（所有需要执行的工具返回 SANDBOX_NOT_CONFIGURED）。
SANDBOX_PROVIDER=local-dev
SANDBOX_COMMAND_ALLOWLIST=npm,node,npx,next,eslint,tsc,git
# ContainerSandbox 使用的镜像（默认 node:22-alpine）
# SANDBOX_IMAGE=node:22-alpine

# P2 外部适配器（未配置时明确 NOT_CONFIGURED，绝不伪造）
MIGRATION_ADAPTER=none
PUBLISH_ADAPTER=none
SHARE_ADAPTER=none
GIT_COMMIT_ENABLED=false

# Compatibility mode: set true when the gateway rejects standard tool-call history.
# Downgrades assistant.tool_calls and role:"tool" to plain text with call ids,
# avoiding illegal orphan tool_calls.
OPENAI_TOOL_MESSAGE_COMPAT=false

# Max consecutive tool failures before stopping the agent with an error (default 3)
QUIBITS_MAX_TOOL_FAILURES=3

# Test-only mock provider: replaces the model service (real tools/build still run)
# QUIBITS_MOCK_PROVIDER=true
